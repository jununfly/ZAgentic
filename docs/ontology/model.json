 "rules": [
  {
   "id": "rule.authority-1to1",
   "statement": "每个 authority-id 恰好绑定到一页（治理契约 rule.G1-docmap-binding）",
   "traces": [
    "docs/README.md"
   ]
  },
  {
   "id": "rule.bucket-count-single-source",
   "statement": "桶计数以 ta-zagentic-overview.md 为唯一真相源，其余架构页只链接不复述",
   "traces": [
    "docs/README.md",
    "docs/architecture/ta-zagentic-overview.md"
   ]
  },
  {
   "id": "rule.plan-material-temporary",
   "statement": "docs/plans/ 下页面为临时过程材料，持久文档不引用（ADR 0010 plan-coupling）",
   "traces": [
    "docs/README.md"
   ]
  },
  {
   "id": "rule.evidence-never-committed",
   "statement": "skills-outputs/ 证据缓存永不入库（gitignored）",
   "traces": [
    "docs/README.md"
   ]
  },
  {
   "id": "rule.lazy-categories",
   "statement": "空类目（methods/testing/benchmarks/references）仅在有对应有界问题文档时惰性创建",
   "traces": [
    "docs/README.md"
   ]
  },
  {
   "id": "rule.golden-immutable",
   "statement": "三个 golden 夹具由契约测试钉死，永不静默删除",
   "traces": [
    "docs/README.md"
   ]
  },
  {
   "id": "rule.ontology-two-modules",
   "statement": "统一本体分 Module G 治理层与 Module P 产品域层",
   "traces": [
    "docs/README.md",
    "docs/zj-adr/0007-unified-ontology-module-g-and-p.md"
   ]
  },
  {
   "id": "rule.skill-closure",
   "statement": "skill 运行期自包含，安装态不依赖源仓路径",
   "traces": [
    "docs/designs/zj-skill-runtime-closure.md"
   ]
  },
  {
   "id": "rule.term-into-zj-context",
   "statement": "新增领域术语先加入 ZJ-CONTEXT.md 再合并",
   "traces": [
    "AGENTS.md"
   ]
  },
  {
   "id": "rule.git-via-zj-git",
   "statement": "所有 git 操作走 scripts/zj-git 或 env -u NODE_OPTIONS git",
   "traces": [
    "AGENTS.md"
   ]
  },
  {
   "id": "rule.process-review-per-pass",
   "statement": "过程材料由治理 pass 逐项审阅，抽取/删除需显式确认",
   "traces": [
    "docs/README.md"
   ]
  }
 ],
