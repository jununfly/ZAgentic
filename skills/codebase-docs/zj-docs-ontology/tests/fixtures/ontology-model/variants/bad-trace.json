   "from": "entity.thing",
   "to": "entity.other"
  }
 ],
 "rules": [
  {
   "id": "rule.things-exist",
   "statement": "Every thing has a name.",
   "traces": [
    "docs/designs/missing.md"
   ]
  }
 ],
 "pages": [
  {
   "path": "docs/designs/overview.md",
   "elements": [
    "entity.thing",
    "attr.thing.name"
   ]
  },
  {
   "path": "docs/designs/detail.md",
   "elements": [
    "entity.other",
    "rel.thing-of-other"
   ]
  },
  {
   "path": "docs/designs/rules.md",
   "elements": [
    "rule.things-exist"
   ]
  }
 ]
}