{
 "schema_version": "ontology-model/v1",
 "object": "docs",
 "entities": [
  {
   "id": "entity.thing",
   "name": "Thing",
   "bounded_question": "What is a thing?",
   "attributes": [
    "attr.thing.name"
   ]
  },
  {
   "id": "entity.other",
   "name": "Other",
   "bounded_question": "What is other?"
  }
 ],
 "attributes": [
  {
   "id": "attr.thing.name",
   "name": "name",
   "owner": "entity.thing"
  }
 ],
 "relations": [
  {
   "id": "rel.thing-of-other",
