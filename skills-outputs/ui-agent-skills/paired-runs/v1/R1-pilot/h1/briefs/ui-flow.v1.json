{
  "schema": "ui-flow/v1",
  "id": "flow.profile-edit",
  "screen": [
    {
      "id": "screen.profile-edit",
      "title": "用户资料编辑",
      "regions": ["form-shell", "feedback-banner", "confirm-dialog"],
      "max_width": 520
    }
  ],
  "component": [
    {"id": "cmp.form-shell", "type": "FormShell", "source": "in-house"},
    {"id": "cmp.nickname", "type": "TextField", "field": "nickname", "max_length": 24},
    {"id": "cmp.email", "type": "TextField", "field": "email", "input_type": "email"},
    {"id": "cmp.bio", "type": "TextArea", "field": "bio", "max_length": 160},
    {"id": "cmp.submit", "type": "SubmitButton", "label": "保存资料"},
    {"id": "cmp.confirm", "type": "ConfirmDialog", "gate": "explicit-user-confirmation"},
    {"id": "cmp.feedback", "type": "FeedbackBanner", "live": "polite"}
  ],
  "state": [
    {"id": "state.idle", "description": "资料已加载，尚未编辑", "terminal": false},
    {"id": "state.validating", "description": "编辑中或实时校验后，可提交当且仅当无错误", "terminal": false},
    {"id": "state.submitting", "description": "用户已确认，输入锁定，等待 mock 响应", "terminal": false},
    {"id": "state.success", "description": "mock 200 且已写入本地持久层", "terminal": true},
    {"id": "state.error", "description": "校验拒绝或 mock 4xx/5xx，可编辑后重试", "terminal": false}
  ],
  "action": [
    {"id": "action.edit", "actor": "user", "from": ["idle", "validating", "error"], "to": "validating", "effect": "更新字段并实时校验"},
    {"id": "action.validate", "actor": "system", "from": ["validating"], "to": "validating", "effect": "重算 errors 与 error_fields"},
    {"id": "action.submit", "actor": "user", "from": ["validating"], "to": "submitting", "effect": "记录人类实签后进入提交"},
    {"id": "action.persist", "actor": "system", "from": ["submitting"], "to": ["success", "error"], "effect": "调用 mock，200 写入持久层并置 persisted"},
    {"id": "action.recover", "actor": "user", "from": ["error"], "to": "validating", "effect": "修正字段后解除阻断"}
  ],
  "intent": [
    {"id": "intent.load-profile", "statement": "用户能看到自己当前的资料"},
    {"id": "intent.prevent-invalid-submit", "statement": "非法输入不产生写入"},
    {"id": "intent.human-confirm", "statement": "每次写入前都有一次用户显式确认"},
    {"id": "intent.recoverable-failure", "statement": "失败后保留输入并允许再次提交"},
    {"id": "intent.lock-during-submit", "statement": "提交中不可修改输入"}
  ],
  "acceptance": [
    {"id": "acc.valid-submit", "given": "字段合法且用户确认", "then": "mock 200，persisted=true，state=success"},
    {"id": "acc.blocked-invalid", "given": "任一字段非法", "then": "submit 被拒，submit_blocked=true，error_fields 非空"},
    {"id": "acc.gate-signed", "given": "动作角色为 user", "then": "human_gates 记录 signed=true 与 at_step"},
    {"id": "acc.no-auto-submit", "given": "动作角色不是 user", "then": "不记录签署且不进入 submitting"},
    {"id": "acc.recovery", "given": "mock 422/500", "then": "state=error，持久层不变，编辑后可再次提交"}
  ],
  "unknown": []
}
