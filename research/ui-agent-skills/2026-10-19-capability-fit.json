{
  "goal": "为 ZAgentic 的界面开发 skills 选择可拆分、可组合、可复核的外部 OSS 能力，而不把任何外部项目误用为全生命周期平台",
  "requirements": [
    {
      "id": "R1",
      "statement": "候选提供一个边界清晰、可由 Agent 调用或作为工程 seam 使用的可复用能力",
      "priority": "must",
      "critical": true,
      "acceptance": "能指出一个独立职责、输入、输出和调用入口"
    },
    {
      "id": "R2",
      "statement": "候选产出可检查、可传递或可回滚的结构化 artifact/output",
      "priority": "must",
      "critical": true,
      "acceptance": "至少有 spec、文档、截图、代码、测试结果或明确的设计记录"
    },
    {
      "id": "R3",
      "statement": "候选可以通过薄适配层接入 ZAgentic，而不接管本仓库的产品语义和 SSOT",
      "priority": "must",
      "critical": true,
      "acceptance": "适配范围限于身份/查询/状态/来源转换，主体能力可移除"
    },
    {
      "id": "R4",
      "statement": "候选具有可固定版本、可审计的源码/许可证/外部依赖责任边界",
      "priority": "must",
      "critical": true,
      "acceptance": "能记录 commit、许可证、升级风险和退出路径"
    },
    {
      "id": "R5",
      "statement": "候选直接补足至少一个界面生命周期缺口：设计方向、协议渲染、原型输入、动效、实现或验证",
      "priority": "want",
      "critical": false,
      "acceptance": "在一个垂直切片中能观察到质量或效率改善"
    },
    {
      "id": "R6",
      "statement": "候选支持跨会话反馈、跨项目复用或跨框架迁移中的至少一种",
      "priority": "want",
      "critical": false,
      "acceptance": "artifact、组件、prompt、renderer 或规则能被下一次工作复用"
    }
  ],
