    "criteria": [
      {
        "id": "design-direction",
        "question": "候选如何把用户目标转译为视觉方向、参考图、风格、版式、配色、字体、动效和设计约束，而不是只生成通用页面？关注 frontend-design、design-taste-frontend、Oil UI、UI UX Pro Max、Superdesign 的 README/SKILL 与 direction/design-system 规则。",
        "critical": true,
        "keywords": ["frontend-design", "design-taste-frontend", "art direction", "direction", "design system", "palette", "typography", "Generative UI", "Material 3 Expressive"]
